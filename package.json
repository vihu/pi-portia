{
  "name": "pi-portia",
  "version": "1.1.0",
  "description": "Pi-native spatial project memory extension backed by SQLite.",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "extension",
    "memory",
    "sqlite",
    "portia"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.mjs'"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vihu/pi-portia.git"
  },
  "bugs": {
    "url": "https://github.com/vihu/pi-portia/issues"
  },
  "homepage": "https://github.com/vihu/pi-portia#readme",
  "dependencies": {
    "better-sqlite3": "^12.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.2",
    "typebox": "^1.1.24",
    "typescript": "^5.9.3"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "package.json",
    "docs",
    "src"
  ]
